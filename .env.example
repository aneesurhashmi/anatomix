# Copy this file to .env and fill in your paths.

# Cache directories (optional — set to redirect HuggingFace/PyTorch caches)
NLTK_DATA="/path/to/cache/nltk"
TORCH_HUB_DIR="/path/to/cache/torch_hub"
TORCH_HOME="/path/to/cache/torch_home"
XDG_CACHE_HOME="/path/to/cache/"

HF_HOME="/path/to/cache/hf_cache"
TRANSFORMERS_CACHE="/path/to/cache/transformer_cache"
HF_DATASETS_CACHE="/path/to/cache/hf_dataset_cache"
HUGGINGFACE_HUB_CACHE="/path/to/cache/hf_hub_cache"
HF_MODULES_CACHE="/path/to/cache/hf_modules_cache"
HF_METRICS_CACHE="/path/to/cache/hf_metrics_cache"
PIP_CACHE_DIR="/path/to/cache/pip_cache"

# HuggingFace token (required for gated models)
HF_TOKEN=your_huggingface_token_here

# Proxy settings (optional — only needed if behind a corporate proxy)
# http_proxy=http://your.proxy.server:port
# https_proxy=http://your.proxy.server:port
# all_proxy=http://your.proxy.server:port
# no_proxy=localhost
